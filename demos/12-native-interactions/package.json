{
  "name": "12-native-interactions",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/renderer && cp src/renderer/*.html dist/renderer/ 2>/dev/null; true",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}